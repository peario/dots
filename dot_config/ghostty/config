# theme = dark:evergarden-spring-green,light:evergarden-summer-green
theme = dark:Catppuccin Macchiato,light:Catppuccin Latte

# Window settings
window-height = 28
window-width = 90
window-padding-x = 8
window-padding-y = 8
window-colorspace = display-p3

# MacOS settings
macos-titlebar-style = hidden

# Other
background-opacity = 0.9
background-blur-radius = 20

font-family = "Maple Mono NF"
font-size = 18

# Possible values for `macos-option-as-alt` (replaces `Option`-key):
# - `true`: Both will be treated as Alt (on ISO-US and ANSI).
# - `false`: Both will be treated as Option (default).
# - `left`: Left Option will be treated as Alt.
# - `right`: Right Option will be treated as Alt.
macos-option-as-alt = true

command = /bin/zsh

# Ghostty's config is of type `key=value`.
# Codeblocks in Ghostty's docs use filetype (and syntax highlight) for `ini`.
# See: https://ghostty.org/docs/config#syntax
#
# vim:ft=ini:cms=#\ %s
