# snippets for making snippets
snippet snipd "new snippet with description"
  snippet ${1:trigger} "${2:description}"
    ${0:${VISUAL}}

snippet snip "new snippet"
  snippet ${1:trigger}
    ${0:${VISUAL}}

snippet v "insert visual"
  {VISUAL}

snippet var "insert variable"
  ${${1:1}:${2:text}}$0
