# 1. Starting conditional profiling via:
# https://kev.inburke.com/kevin/profiling-zsh-startup-time/
# INFO: TOTAL STARTUP TIME SHOULD AT MAX BE 7ms!
: "${PROFILE_STARTUP:=false}"
: "${PROFILE_ALL:=false}"
# Run this to get a profile trace and exit: time zsh -i -c echo
# Or: time PROFILE_STARTUP=true /bin/zsh -i --login -c echo
if [[ "$PROFILE_STARTUP" == true ]]; then
    zmodload zsh/zprof        # start timer
    PS4='%D{%s%3>u} %N:%i> '  # timestamp each command (for xtrace)
    exec 3>&2 2>$ZDOTDIR/zsh-start.log
    setopt xtrace prompt_subst
fi

# 2. Environmental variables (early)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export HISTFILE="$ZDOTDIR/histfile"
export HISTSIZE=5000
export SAVEHIST=3000

# 3. Initialize Zinit (fast plugin manager)
ZINIT_HOME="${ZDOTDIT:-$HOME/.config/zsh}/zinit"
if [ ! -f "$ZINIT_HOME/zinit.zsh" ]; then
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
source "$ZINIT_HOME/zinit.zsh" # Load zinit itself

# 4. Load modules
zmodload zsh/complist # enabled before compinit
zmodload zsh/zle # Usually auto-enabled

## 4.1. Related keymaps
autoload -z edit-command-line
zle -N edit-command-line
bindkey "^e" edit-command-line

# 5. Load custom styling, options and conditional assignments
## 5.1. Define zstyle and styling
autoload -Uz colors && colors     # Initialize $fg[], $bg[], etc.
[[ -s "$ZDOTDIR/zstyle.zsh" ]] && source "$ZDOTDIR/zstyle.zsh"

## 5.2. Load zsh options
[[ -s "$ZDOTDIR/options.zsh" ]] && source "$ZDOTDIR/options.zsh"

## 5.3. Load zsh options (miscellaneous)
[[ -s "$ZDOTDIR/misc.zsh" ]] && source "$ZDOTDIR/misc.zsh"

# 6. Load Zinit plugins with `load`, `snippet`, etc.
## 6.1. Load zsh-defer for idle-time loading
# NOTE: `zsh-defer` === `zinit ice wait`
zinit light romkatv/zsh-defer

## 6.2. Oh-My-Zsh plugins via Zinit snippets (fast, no compinit issues)
zinit snippet OMZ::plugins/command-not-found/command-not-found.plugin.zsh
# zinit snippet OMZ::plugins/copybuffer/copybuffer.plugin.zsh
# zinit snippet OMZ::plugins/web-search/web-search.plugin.zsh

## 6.3. zsh-users plugins (fast-loading with Turbo mode)
### 6.3.1. zsh-completions (extra completions, loaded light for speed)
# zinit ice wait light zsh-users/zsh-completions

### 6.3.2. zsh-autosuggestions (deferred 0ms at startup; installs in background)
ZSH_AUTOSUGGEST_USE_ASYNC="true"
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_AUTOSUGGEST_HISTORY_IGNORE=$'*\n*'

zinit wait lucid light-mode for \
  zdharma-continuum/fast-syntax-highlighting \
  atload:"_zsh_autosuggest_start" zsh-users/zsh-autosuggestions \
  blockf atpull:'zinit creinstall -q .' zsh-users/zsh-completions

### 6.3.3. zsh-history-substring-search (deferred, augment arrow-key history search)
zinit ice wait lucid light zsh-users/zsh-history-substring-search

# 7. Completion system: zcompdump cache
autoload -Uz compinit
# 7.1. If zcompdump is older than 24h, rebuild; else use compiled dump
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit          # PERF: ~20ms (actual rebuild time varies)
else
  compinit -C       # PERF: ~2ms (load compiled completions)
fi
zinit cdreplay -q   # PERF: ~1ms (replay any deferred compdefs)

# NOTE: bashcompinit is disabled due to high cost (~466ms)
# autoload -Uz bashcompinit; bashcompinit  # PERF: ~466ms (commented out)

# 8. Load conditional assignments for tooling (eg. bat, starship)
# This requires to load after `compinit` due to completions (compdefs)
[[ -f "$ZDOTDIR/tools.zsh" ]] && source "$ZDOTDIR/tools.zsh"

## 8.1. Load aliases for zsh
## Load after `tools.zsh` as some aliases requires some tools
[[ -s "$ZDOTDIR/alias.zsh" ]] && source "$ZDOTDIR/alias.zsh"

# 9. End profiling
if [[ "$PROFILE_STARTUP" == true ]]; then
    unsetopt xtrace         # stop tracing
    exec 2>&3 3>&-          # restore stderr
    zprof                   # show profile report
fi
