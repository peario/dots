# Don't have ripgrep vomit a bunch of stuff on the screen
# show a preview of the match
--max-columns=150
--max-columns-preview

# Some useful flags for either performance and/or accuracy
--smart-case
--infercase
--hidden
--follow
--trim

# ignore git and vendor files
--glob=!.git/*
--glob=!.hg/*
--glob=!node_modules/*
--glob=!.cache/*
--glob=!dist/*
--glob=!build/*
--glob=!target/*
--glob=!.next/*
--glob=!.svelte-kit/*
--glob=!.turbo/*
--glob=!coverage/*
--glob=!vendor/*
--glob=!*.min.*
--glob=!*.map
